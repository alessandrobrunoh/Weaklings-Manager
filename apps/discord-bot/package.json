{
  "name": "discord-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=../../.env --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && DISCORD_BOT_TOKEN=test DISCORD_CLIENT_ID=test DISCORD_GUILD_ID=test BOT_API_SECRET=test node --test dist/embeds/*.test.js dist/services/*.test.js",
    "start": "node --env-file=../../.env dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.17.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "~5.9.2"
  }
}
